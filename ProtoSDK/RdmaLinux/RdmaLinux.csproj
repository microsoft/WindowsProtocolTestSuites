<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Microsoft.Protocols.TestTools.StackSdk.FileAccessService.RdmaLinux</RootNamespace>
    <AssemblyName>Microsoft.Protocols.TestTools.StackSdk.FileAccessService.RdmaLinux</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Platforms>AnyCPU;x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DefineConstants>TRACE;DEBUG;UT;LINUX</DefineConstants>
    <WarningLevel>3</WarningLevel>
    <DocumentationFile>bin\Debug\Microsoft.Protocols.TestTools.StackSdk.FileAccessService.RdmaLinux.xml</DocumentationFile>
    <CodeAnalysisRuleSet>AllRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>TRACE;DEBUG;UT;LINUX</DefineConstants>
    <WarningLevel>3</WarningLevel>
    <DocumentationFile>bin\Debug\Microsoft.Protocols.TestTools.StackSdk.FileAccessService.RdmaLinux.xml</DocumentationFile>
    <CodeAnalysisRuleSet>AllRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DefineConstants>TRACE;LINUX</DefineConstants>
    <CodeAnalysisRuleSet>AllRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <OutputPath>bin\x64\Release\</OutputPath>
    <DefineConstants>TRACE;LINUX</DefineConstants>
    <CodeAnalysisRuleSet>AllRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Runtime.InteropServices" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\AssemblyInfo\SharedAssemblyInfo.cs">
      <Link>SharedAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>

  <!-- Copy native library during build -->
  <Target Name="CopyNativeLibrary" BeforeTargets="Build">
    <Message Text="Copying native RDMA library for Linux..." Importance="high" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)src\libRdmaLinuxAdapter.so" 
          DestinationFiles="$(OutputPath)libRdmaLinuxAdapter.so" 
          Condition="Exists('$(MSBuildThisFileDirectory)src\libRdmaLinuxAdapter.so')" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)out\libRdmaLinuxAdapter.so" 
          DestinationFiles="$(OutputPath)libRdmaLinuxAdapter.so" 
          Condition="Exists('$(MSBuildThisFileDirectory)out\libRdmaLinuxAdapter.so')" />
  </Target>

  <Target Name="AfterBuild">
    <Copy SourceFiles="$(TargetDir)$(TargetFileName)" DestinationFolder="..\..\drop\ProtoSDK\Bin\" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="..\..\drop\ProtoSDK\Bin\" />
    <Copy SourceFiles="$(TargetDir)libRdmaLinuxAdapter.so" DestinationFolder="..\..\drop\ProtoSDK\Bin\" 
          Condition="Exists('$(TargetDir)libRdmaLinuxAdapter.so')" />
  </Target>

  <!-- Linux-specific build configuration -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
  </PropertyGroup>
</Project>